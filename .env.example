# ==============================================================================
# Volur Lite CTF 平台 - 统一环境变量配置文件模版 (.env.example)
#
# 使用说明:
# 1. 复制本文件为 .env: cp .env.example .env (Linux/macOS) 或 copy .env.example .env (Windows)
# 2. 根据本地或生产环境实际情况修改相关配置项
# 3. 注意: 严禁将包含真实敏感密钥的 .env 文件提交至 Git 版本控制仓库
# 4. 业务策略（注册开关、邮箱验证、验证码、邮件 SMTP、动态 Flag 格式等）均已收敛在数据库系统设置中动态管理
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务与运行环境 (Basic Service & Runtime Environment)
# ------------------------------------------------------------------------------
# Spring Profile 激活环境 (dev: 本地开发, prod: 生产环境, test: 测试环境)
SPRING_PROFILES_ACTIVE=dev

# 后端 Spring Boot 应用监听端口 (默认: 8080)
SERVER_PORT=8080

# 前端 Nginx 监听与对外暴露端口 (默认: 80)
NGINX_HTTP_PORT=80


# ------------------------------------------------------------------------------
# 2. MySQL 关系型数据库配置 (MySQL Database Configuration)
# ------------------------------------------------------------------------------
# MySQL 服务主机地址 (本地开发填 localhost, Docker Compose 网络填 volur-mysql)
VOLUR_MYSQL_HOST=localhost

# 数据库用户名 (默认: root)
VOLUR_MYSQL_USER=root

# 数据库连接密码 (生产环境请务必修改为强密码)
VOLUR_MYSQL_PASSWORD=root123456


# ------------------------------------------------------------------------------
# 3. Redis 缓存与分布式服务配置 (Redis Cache & Pub/Sub Configuration)
# ------------------------------------------------------------------------------
# Redis 服务主机地址 (本地开发填 localhost, Docker Compose 网络填 volur-redis)
VOLUR_REDIS_HOST=localhost

# Redis 访问密码 (无密码可留空，建议生产环境启用密码)
VOLUR_REDIS_PASSWORD=volur_redis_secret_2026

# Redis 数据库索引库 (默认: 0)
VOLUR_REDIS_DATABASE=0


# ------------------------------------------------------------------------------
# 4. MongoDB 文档数据库配置 (MongoDB Database Configuration)
# ------------------------------------------------------------------------------
# MongoDB 服务主机地址 (本地开发填 localhost, Docker Compose 网络填 volur-mongodb)
VOLUR_MONGO_HOST=localhost


# ------------------------------------------------------------------------------
# 5. JWT 身份认证与安全配置 (JWT Authentication & Security)
# ------------------------------------------------------------------------------
# JWT 签名密钥 (生产环境请务必生成至少 256 位强随机字符串，切勿泄露)
VOLUR_JWT_SECRET=VolurLitePlatformSecretKeyForJwtAuthentication2026SecureString!

# Access Token 过期时间 (单位: 秒，默认 86400 秒 = 24 小时)
VOLUR_JWT_EXPIRE_SECONDS=86400

# Refresh Token 过期时间 (单位: 毫秒，默认 604800000 毫秒 = 7 天)
VOLUR_JWT_REFRESH_EXPIRATION_MS=604800000

# Remember-Me 长期 Refresh Token 过期时间 (单位: 毫秒，默认 2592000000 毫秒 = 30 天)
VOLUR_JWT_REMEMBER_ME_REFRESH_EXPIRATION_MS=2592000000


# ------------------------------------------------------------------------------
# 6. CTF 容器与动态靶场编排配置 (Container Runtime: Docker / K3s)
# ------------------------------------------------------------------------------
# [Docker 运行时]
# Docker Daemon 守护进程套接字地址
# - Windows / 远程环境: tcp://localhost:2375
# - Linux 本地环境: unix:///var/run/docker.sock
VOLUR_CONTAINER_DOCKER_HOST=tcp://localhost:2375

# [K3s / Kubernetes 运行时 (可选集群模式)]
# 靶机 Pod 运行的 Kubernetes 命名空间 (默认: volur-challenges)
VOLUR_K3S_NAMESPACE=volur-challenges

# 选手访问靶机实例的公共 IP 或域名 (默认: 127.0.0.1)
VOLUR_K3S_PUBLIC_HOST=127.0.0.1

# K3s 集群 kubeconfig 配置文件绝对路径
VOLUR_K3S_KUBECONFIG_PATH=/etc/rancher/k3s/k3s.yaml

# K3s API Server Master URL
VOLUR_K3S_MASTER_URL=https://127.0.0.1:6443


# ------------------------------------------------------------------------------
# 7. 可选大数据与消息流组件 (Optional Infrastructure: Elasticsearch & Kafka)
# ------------------------------------------------------------------------------
# Elasticsearch JVM 堆内存限制参数
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Kafka KRaft 集群标识 ID
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
