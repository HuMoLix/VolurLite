<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.humolix.volur</groupId>
        <artifactId>volur-lite-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>volur-server</artifactId>
    <packaging>jar</packaging>
    <name>volur-server</name>
    <description>Application bootstrap module and monolithic aggregation server</description>

    <dependencies>
        <!-- Internal Feature Modules -->
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-verification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-challenge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-container</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-httpclient-jdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-competition</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-logging</artifactId>
        </dependency>

        <!-- Database Driver Runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Actuator for health check & metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.humolix.volur.VolurLiteApplication</mainClass>
                    <layout>JAR</layout>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
