    <dependencies>
        <!-- Volur Core Framework & Internal Modules -->
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-verification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-notification</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
