    <description>Dynamic k3s container and sandbox orchestration module</description>

    <dependencies>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-challenge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.humolix.volur</groupId>
            <artifactId>volur-logging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

