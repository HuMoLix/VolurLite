user nginx;
worker_processes auto;

error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
    multi_accept on;
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    keepalive_timeout 65;
    client_max_body_size 2048M;

    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/x-javascript
        text/xml
        application/xml
        application/xml+rss
        text/javascript
        image/svg+xml;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    types_hash_max_size 2048;

    upstream volur_backend {
        server volur-app:8080 max_fails=3 fail_timeout=10s;
        keepalive 64;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map $ssl_protocol $effective_tls_protocol {
        default $ssl_protocol;
        ""      "";
    }
    map $ssl_cipher $effective_tls_cipher {
        default $ssl_cipher;
        ""      "";
    }
    map $ssl_ciphers $effective_tls_ciphers {
        default $ssl_ciphers;
        ""      "";
    }
    map $ssl_curves $effective_tls_curves {
        default $ssl_curves;
        ""      "";
    }
    map $ssl_alpn_protocol $effective_tls_alpn {
        default $ssl_alpn_protocol;
        ""      "";
    }
    map $ssl_session_reused $effective_tls_session_reused {
        default $ssl_session_reused;
        ""      "";
    }

    limit_conn_zone $remote_addr zone=volur_conn_limit:10m;
    limit_req_zone $remote_addr zone=volur_api_req_limit:10m rate=30r/s;
    limit_req_zone $remote_addr zone=volur_auth_req_limit:10m rate=5r/s;
    limit_req_status 429;
    limit_conn_status 429;

    server {
        listen 80;
        listen [::]:80;
        server_name localhost;

        root /usr/share/nginx/html;

        limit_conn volur_conn_limit 50;

        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-TLS-Protocol $effective_tls_protocol;
        proxy_set_header X-TLS-Cipher $effective_tls_cipher;
        proxy_set_header X-TLS-Ciphers $effective_tls_ciphers;
        proxy_set_header X-TLS-Curves $effective_tls_curves;
        proxy_set_header X-TLS-ALPN $effective_tls_alpn;
        proxy_set_header X-TLS-Session-Reused $effective_tls_session_reused;

        proxy_set_header Connection "";

        location / {
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-XSS-Protection "1; mode=block" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        }

        location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
            expires 30d;
            add_header Cache-Control "public, no-transform";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            access_log off;
        }

        location ~ /\.(?!well-known).* {
            deny all;
            access_log off;
            log_not_found off;
        }

        location = /api/v1/realtime/stream {
            proxy_pass http://volur_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection '';
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        location ^~ /api/v1/auth/login {
            limit_req zone=volur_auth_req_limit burst=10 nodelay;
            limit_conn volur_conn_limit 15;
            proxy_pass http://volur_backend;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location ^~ /api/v1/auth/register {
            limit_req zone=volur_auth_req_limit burst=10 nodelay;
            limit_conn volur_conn_limit 15;
            proxy_pass http://volur_backend;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location ^~ /api/v1/email/captcha {
            limit_req zone=volur_auth_req_limit burst=10 nodelay;
            limit_conn volur_conn_limit 15;
            proxy_pass http://volur_backend;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location ^~ /api/v1/captcha {
            limit_req zone=volur_auth_req_limit burst=15 nodelay;
            limit_conn volur_conn_limit 20;
            proxy_pass http://volur_backend;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        location ^~ /api/ {
            limit_req zone=volur_api_req_limit burst=50 nodelay;
            limit_conn volur_conn_limit 50;

            proxy_pass http://volur_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_set_header X-TLS-Protocol $effective_tls_protocol;
            proxy_set_header X-TLS-Cipher $effective_tls_cipher;
            proxy_set_header X-TLS-Ciphers $effective_tls_ciphers;
            proxy_set_header X-TLS-Curves $effective_tls_curves;
            proxy_set_header X-TLS-ALPN $effective_tls_alpn;
            proxy_set_header X-TLS-Session-Reused $effective_tls_session_reused;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            proxy_buffer_size 16k;
            proxy_buffers 4 32k;
            proxy_busy_buffers_size 64k;
        }
    }

# if you want to enable HTTPS, you can uncomment the following server block and configure SSL certificates accordingly.
#     server {
#         listen 80;
#         listen [::]:80;
#         server_name yourdomain.com;
#         return 301 https://$host$request_uri;
#     }
#
#     server {
#         listen 443 ssl http2;
#         listen [::]:443 ssl http2;
#         server_name yourdomain.com;
#
#         ssl_certificate /etc/nginx/ssl/yourdomain.com.crt;
#         ssl_certificate_key /etc/nginx/ssl/yourdomain.com.key;
#         ssl_protocols TLSv1.2 TLSv1.3;
#         ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
#         ssl_prefer_server_ciphers on;
#         ssl_session_cache shared:SSL:10m;
#         ssl_session_timeout 1d;
#         ssl_session_tickets off;
#
#         root /usr/share/nginx/html;
#     }
#     server {
#         listen 443 ssl http2;
#         listen [::]:443 ssl http2;
#         server_name *.node.yourdomain.com;
#     }
#
#     server {
#         listen 443 ssl http2;
#         listen [::]:443 ssl http2;
#         server_name pwn.challenge.volurctf.com;
#     }

}
